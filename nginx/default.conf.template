# Rendered by the nginx image at start-up (envsubst). Only LB_DIRECTIVE and APP_SERVERS are substituted;
# nginx's own $variables are left untouched.
upstream sis_backend {
    zone sis_backend 64k;
    ${LB_DIRECTIVE}
    ${APP_SERVERS}
    keepalive 64;
}

log_format lb '$remote_addr [$time_local] "$request" $status upstream=$upstream_addr urt=$upstream_response_time rt=$request_time';

server {
    listen 80;
    access_log /var/log/nginx/access.log lb;

    location / {
        proxy_pass http://sis_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # If a server is stopped/unreachable, retry the request on another one.
        proxy_next_upstream error timeout http_502;
        proxy_next_upstream_tries 2;
        proxy_connect_timeout 2s;
        proxy_read_timeout 60s;

        add_header X-Upstream $upstream_addr always;
    }
}