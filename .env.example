# Copy to .env (docker compose reads it automatically). Never commit .env.
SIS_DEMO_PASSWORD=ChooseYourOwnDemoPassword
# 600 = normal. For load tests set 1000000, otherwise the shared admin token is throttled (HTTP 429).
SIS_API_LIMIT=600
SIS_AUTH_LIMIT=20
# CPU / memory limit per application server (fixed capacity makes scaling results meaningful)
APP_CPUS=1.0
APP_MEM=768m
# Used only when running the backend outside Docker (mvn spring-boot:run):
MONGO_URI=mongodb://localhost:27017/sis
REDIS_HOST=localhost
REDIS_PORT=6379
